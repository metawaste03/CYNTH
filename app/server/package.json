{
  "name": "cynth-server",
  "private": true,
  "version": "0.1.0",
  "description": "Cynth backend (Node.js + Express). SQLite-backed CRUD for authors and products.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "import:skills": "tsx scripts/import-author-skills.ts",
    "map:authors": "tsx scripts/map-remote-authors.ts",
    "export:registry": "tsx scripts/export-product-registry.ts",
    "normalise:categories": "tsx scripts/normalise-product-categories.ts",
    "align:themes": "tsx scripts/align-theme-names.ts",
    "apply:links": "tsx scripts/apply-internal-links.ts",
    "balance": "tsx scripts/area-balance.ts",
    "rerun:writer": "tsx scripts/rerun-writer.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
