# Cynth server — local development configuration.
#
# Copy this file to .env.local and edit it. .env.local is gitignored and must
# never be committed; this .env.example is the committed template and must
# never contain a real secret.

# ---------------------------------------------------------------- networking

# Port the Express server listens on.
#
# Deliberately not 4000: Local (the WordPress development environment used for
# EveryFiveDays) occupies that port, and Cynth is meant to run alongside it.
#
# The Vite dev server reads this same value to point its /api proxy at the
# backend, so the client and server cannot drift apart. Change it here only.
CYNTH_SERVER_PORT=4100

# Optional. Overrides the proxy target entirely, for the unusual case where the
# backend is not on localhost at the port above.
# CYNTH_SERVER_URL=http://localhost:4100

# Optional. Port the Vite dev server itself listens on. Default: 5173.
# CYNTH_CLIENT_PORT=5173

# ------------------------------------------------------------ provider keys

# API keys are never stored in SQLite. The database records only the NAME of
# the environment variable holding a key (ai_providers.api_key_env_var); the
# value lives here, in .env.local, and is loaded into process.env at startup.
#
# You do not normally write these by hand: saving a key in
# Settings -> AI Providers makes Cynth write it to .env.local itself, using the
# naming convention CYNTH_PROVIDER_<provider id>_API_KEY.
#
# Example — provider id 3 ("OpenRouter Main"):
# CYNTH_PROVIDER_3_API_KEY=replace-with-your-real-key

# --------------------------------------------------------- CMS credentials

# WordPress (and any future CMS) credentials are stored exactly like provider
# keys: SQLite records only the NAME of the environment variable
# (cms_connections.credential_env_var), and the value lives here.
#
# You do not normally write these by hand: saving an application password in
# Settings -> WordPress makes Cynth write it to .env.local itself, using the
# naming convention CYNTH_CMS_<connection id>_CREDENTIAL.
#
# Use a WordPress Application Password (Users -> Profile -> Application
# Passwords), never an account password.
#
# Example - connection id 2 ("EveryFiveDays (local)"):
# CYNTH_CMS_2_CREDENTIAL=xxxx xxxx xxxx xxxx xxxx xxxx

# ------------------------------------------------------- production serving

# Whether the server also serves the built client from app/client/dist.
#
# Unset is correct for both modes: `npm run dev` (tsx, from source) does not
# serve a built client, and `npm start` (node dist/index.js) does. Set it only
# to override that - "true" to exercise a build from source, "false" to run
# the API alone in production.
# CYNTH_SERVE_CLIENT=true

# Optional. Where the built client lives, if it is not app/client/dist.
# CYNTH_CLIENT_DIST=
